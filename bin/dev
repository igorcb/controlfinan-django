#!/bin/sh
# Development: build the CSS, keep watching it, migrate and run the Django dev server.
set -e
tailwindcss -i finance/static/finance/css/app.tailwind.css -o finance/static/finance/css/app.css
tailwindcss -i finance/static/finance/css/app.tailwind.css -o finance/static/finance/css/app.css --watch=always &
python manage.py migrate --noinput
exec python manage.py runserver 0.0.0.0:8000
